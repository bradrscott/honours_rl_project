#!/bin/bash
# ── Smoke test: does 9x9 PPO run on a Lengau compute node, how fast,
#    and does the compute node have internet (for live wandb)? ──────
# Submit:  qsub run_smoke_9x9_chpc.pbs     Watch: qstat -u bscott
# Read the answers in smoke9x9.out when it finishes.

#PBS -N SMOKE9x9
#PBS -P CSCI1142
#PBS -q serial
#PBS -l select=1:ncpus=6
#PBS -l walltime=00:20:00
#PBS -o /mnt/lustre/users/bscott/HonoursProject/smoke9x9.out
#PBS -e /mnt/lustre/users/bscott/HonoursProject/smoke9x9.err
#PBS -m n

source ~/.bashrc
module purge
module load chpc/python/anaconda/3-2021.11
source activate rl_project
cd /mnt/lustre/users/bscott/HonoursProject

echo "=== HOST: $(hostname) ==="
echo "=== Q3: does this COMPUTE node have internet? ==="
curl -sS -I --max-time 10 https://pypi.org 2>&1 | head -1 || echo "NO INTERNET on compute node"
echo "--- wandb API reachable from compute node? ---"
curl -sS -I --max-time 10 https://api.wandb.ai 2>&1 | head -1 || echo "wandb API UNREACHABLE from compute node"

export OMP_NUM_THREADS=6
export BOARD_SIZE=9
export KOMI=5.5
export OPPONENT=greedy
export WANDB_MODE=offline          # isolate the speed test from network
export TOTAL_TIMESTEPS=40000       # ~20 PPO updates — enough to time throughput

echo "=== Q1+Q2: PPO 9x9 vs greedy, 40k steps — START $(date +%T) ==="
python ppo/ppo_go.py
echo "=== DONE $(date +%T) ==="
