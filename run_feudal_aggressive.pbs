#!/bin/bash
# ── Feudal Phase-1, SINGLE opponent: aggressive — CHPC Lengau (PBS Pro) ──
# Submit with:  qsub run_feudal_aggressive.pbs
# Monitor with: qstat -u bscott     Cancel with: qdel <jobid>
# NOTE: #PBS lines must NOT have trailing comments — PBS reads them as arguments.

#PBS -N FEU_aggr
#PBS -P CSCI1142
#PBS -q serial
#PBS -l select=1:ncpus=4
#PBS -l walltime=48:00:00
#PBS -m abe
#PBS -M sctbra008@myuct.ac.za

# serial = CPU queue (no GPU access on this project); ncpus=4 for torch threads.
# stdout/stderr land in the submit dir as FEU_aggr.o<jobid> / .e<jobid>.

# ── Environment ───────────────────────────────────────────────────
module purge
module load chpc/python/anaconda/3-2024.10.1
source /mnt/lustre/users/bscott/HonoursProject/rl_env/bin/activate
export OMP_NUM_THREADS=4

# wandb OFFLINE (no internet on Lengau); sync from your Mac later. USE_WANDB=0 to disable.
export USE_WANDB=1
export WANDB_MODE=offline

# ~23 steps/s on CPU → 3M ≈ 36h, fits 48h serial. Match ppo_go for fairness.
export TOTAL_TIMESTEPS=3000000

# ── Run ───────────────────────────────────────────────────────────
cd /mnt/lustre/users/bscott/HonoursProject
export OPPONENT=aggressive
echo "Single run -> OPPONENT=${OPPONENT}"
python feudalAgent.py
