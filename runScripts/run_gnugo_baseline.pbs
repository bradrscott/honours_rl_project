#!/bin/bash
# ── GNU Go baseline for CHPC Lengau (PBS Pro) — CPU ONLY ──────────
# GNU Go needs NO GPU, so this targets a CPU queue (much better on Lengau
# than a GPU queue). One opponent per array index -> per-opponent wandb runs.
# Submit:  qsub run_gnugo_baseline.pbs        Monitor: qstat -u <user>
#
# >>> Lengau prerequisites you must set up FIRST (you have none of these yet):
#   1. A conda env on Lengau with numpy + pettingzoo[classic] + wandb
#   2. gnugo installed in it:  conda install -c conda-forge gnugo
#   3. The reorganized repo on your lustre scratch
#   4. Confirm the # CONFIRM lines (queue / project / path / module) vs the
#      CHPC wiki (wiki.chpc.ac.za) or CHPC support.

#PBS -N GNUGO_base
#PBS -P CSCI1142                        # CONFIRM: your project allocation
#PBS -q serial                          # CONFIRM: a CPU queue (serial/smp) — NOT a GPU queue
#PBS -l select=1:ncpus=4                # CONFIRM: CPU-only, no ngpus
#PBS -l walltime=12:00:00
#PBS -J 0-4                             # PBS job array: one opponent per index
#PBS -o /mnt/lustre/users/REPLACE_USER/HonoursProject/gnugo_^array_index^.out   # CONFIRM path
#PBS -e /mnt/lustre/users/REPLACE_USER/HonoursProject/gnugo_^array_index^.err   # CONFIRM path
#PBS -m abe
#PBS -M sctbra008@myuct.ac.za

module purge
module load chpc/python/anaconda/3-2021.11     # CONFIRM module name
source activate rl_project                      # CONFIRM: env you built on Lengau

cd /mnt/lustre/users/REPLACE_USER/HonoursProject # CONFIRM path

OPPONENTS=(greedy defensive corner edge random)
export OPPONENT=${OPPONENTS[$PBS_ARRAY_INDEX]}

echo "GNU Go baseline vs ${OPPONENT}"
python gnugo/run_baseline.py --opponent "${OPPONENT}" --games 200 --level 10 \
       --board-size 13 --komi 7.5
