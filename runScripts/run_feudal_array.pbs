#!/bin/bash
# ── Feudal Phase-1 array for CHPC Lengau (PBS Pro) ────────────────
# Feudal vs ALL 5 opponents, one array subjob each (idx 0-4).
# OPPONENT env var picks the opponent; config_feudal.py reads it and writes
# to a per-opponent models/feudal/<opp>/ + logs/ dir.
#
# Submit with:  qsub run_feudal_array.pbs
# Monitor with: qstat -u bscott -t        (‑t expands array subjobs)
# Cancel with:  qdel <jobid>[]            (the [] cancels the whole array)

#PBS -N FEU_Go_arr
#PBS -P CSCI1142
#PBS -q serial
#PBS -l select=1:ncpus=4
#PBS -l walltime=48:00:00
#PBS -J 0-4
#PBS -m abe
#PBS -M sctbra008@myuct.ac.za
# stdout/stderr land in the submit dir as FEU_Go_arr.o<jobid>.<idx> / .e<jobid>.<idx>

# ── Environment ───────────────────────────────────────────────────
# venv built offline from the anaconda-module python + pre-downloaded wheels
module purge
module load chpc/python/anaconda/3-2024.10.1
source /mnt/lustre/users/bscott/HonoursProject/rl_env/bin/activate
export OMP_NUM_THREADS=4          # match ncpus so torch uses the cores requested

# wandb in OFFLINE mode: logs locally (no internet on Lengau), sync from your Mac later.
# Requires wandb installed into rl_env. Set USE_WANDB=0 to disable entirely.
export USE_WANDB=1
export WANDB_MODE=offline

# CPU throughput ~23 steps/s (13x13, 4 cores) → ~3.6M max in 48h serial walltime.
# 5M config default won't fit; 3M ≈ 36h fits with margin. MUST match ppo_go for fairness.
export TOTAL_TIMESTEPS=3000000

# ── Run ───────────────────────────────────────────────────────────
cd /mnt/lustre/users/bscott/HonoursProject

OPPONENTS=(greedy defensive corner edge random)
export OPPONENT=${OPPONENTS[$PBS_ARRAY_INDEX]}

echo "Array subjob ${PBS_ARRAY_INDEX} -> OPPONENT=${OPPONENT}"
python feudal/feudalAgent.py
