#!/bin/bash
# ── Feudal 9x9 on CHPC Lengau (PBS Pro) — array over the 6 opponents ─
# Submit:  qsub run_feudal_9x9_chpc.pbs    Monitor: qstat -u bscott
# Mirrors run_ppo_9x9_chpc.pbs (same board/komi/budget) for a fair comparison.
# >>> CONFIRM the # CONFIRM lines against the CHPC wiki before first use.

# NOTE: PBS directives must NOT have trailing comments — PBS reads the whole
# rest of the line as the value. Settings: project CSCI1142, CPU queue "serial",
# 12 cores, 48h walltime (feudal on CPU is very slow), array 0-4 = one opp/index.
#PBS -N FEU_9x9
#PBS -P CSCI1142
#PBS -q serial
#PBS -l select=1:ncpus=12
#PBS -l walltime=48:00:00
#PBS -J 0-4
#PBS -o /mnt/lustre/users/bscott/HonoursProject/feu9x9_^array_index^.out
#PBS -e /mnt/lustre/users/bscott/HonoursProject/feu9x9_^array_index^.err
#PBS -m abe
#PBS -M sctbra008@myuct.ac.za

source ~/.bashrc
module purge
module load chpc/python/anaconda/3-2021.11   # CONFIRM module name
source activate rl_project                    # CONFIRM env name

cd /mnt/lustre/users/bscott/HonoursProject     # CONFIRM path

export OMP_NUM_THREADS=12          # let CPU torch use the allocated cores
# CONFIRMED (smoke test cnode0609): compute nodes have NO internet, so wandb
# MUST run offline or it hangs at init retrying. Sync from login1 afterwards:
#   export WANDB_API_KEY=<key>; wandb sync logs/feudal/9x9/*/wandb/offline-run-*
export WANDB_MODE=offline
export BOARD_SIZE=9
export KOMI=5.5
export TOTAL_TIMESTEPS=3000000

OPPONENTS=(greedy defensive corner edge random)
export OPPONENT=${OPPONENTS[$PBS_ARRAY_INDEX]}

echo "9x9 CHPC feudal task ${PBS_ARRAY_INDEX} -> OPPONENT=${OPPONENT}"
python feudal/feudalAgent.py
