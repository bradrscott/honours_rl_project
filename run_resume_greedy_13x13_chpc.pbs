#!/bin/bash
# ── RESUME feudal 13x13 vs greedy: finish the last 0.8M (hit the 48h wall) ─
# The from-scratch 13x13 greedy run was killed by the 48h walltime at ~4.2M of
# 5M. This resumes from its latest periodic checkpoint and trains 0.8M more so
# the total training budget matches the other opponents (5M). RESUME_FROM only
# loads weights (global_step restarts at 0), so TOTAL_TIMESTEPS=800000 gives the
# remaining steps. Optimizer restarts fresh (same as all our resumes) — a minor
# discontinuity, negligible on greedy which is already near-converged.
# Submit:  qsub run_resume_greedy_13x13_chpc.pbs
#
# NOTE: PBS directives must NOT have trailing comments.
#PBS -N FRES_gr13
#PBS -P CSCI1142
#PBS -q serial
#PBS -l select=1:ncpus=12
#PBS -l walltime=24:00:00
#PBS -o /mnt/lustre/users/bscott/HonoursProject/fres_greedy13.out
#PBS -e /mnt/lustre/users/bscott/HonoursProject/fres_greedy13.err
#PBS -m abe
#PBS -M sctbra008@myuct.ac.za

source ~/.bashrc
module purge
module load chpc/python/anaconda/3-2021.11
source activate rl_project

cd /mnt/lustre/users/bscott/HonoursProject

export OMP_NUM_THREADS=12
export WANDB_MODE=offline
export BOARD_SIZE=13
export KOMI=7.5
export OPPONENT=greedy
export TOTAL_TIMESTEPS=800000
export RUN_TAG=resume-to-5M

# Auto-pick the HIGHEST-numbered periodic checkpoint from the original run
# (excludes feudal_go_final.pt via the [0-9]+ pattern; the killed run has none).
export RESUME_FROM=$(ls -1 models/feudal/13x13/greedy/feudal_go_[0-9]*.pt \
    | sort -t_ -k3 -n | tail -1)

echo "13x13 feudal RESUME vs greedy: RESUME_FROM=${RESUME_FROM}, +${TOTAL_TIMESTEPS} steps"
if [ -z "${RESUME_FROM}" ] || [ ! -f "${RESUME_FROM}" ]; then
    echo "ERROR: no greedy checkpoint found to resume from — aborting." >&2
    exit 1
fi
python feudal/feudalAgent.py
